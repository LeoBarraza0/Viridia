<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Def_3" targetNamespace="http://viridia.example/bpmn" exporter="generar_bpmn.py (VIRIDIA, Corte III)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_3">
    <bpmn:documentation>VIRIDIA S.A.S. BIC (empresa ficticia, uso académico). BPMN · Subproceso «Cierre mensual: cálculo y facturación del ahorro verificado».</bpmn:documentation>
    <bpmn:participant id="P3_CLI" name="CLIENTE" processRef="Proc3_Cliente"/>
    <bpmn:participant id="P3_VIR" name="VIRIDIA · Cierre mensual" processRef="Proc3_Cierre"/>
    <bpmn:messageFlow id="Msg_3_32" name="Solicitud de ajuste" sourceRef="s_doc" targetRef="c_ajS"/>
    <bpmn:messageFlow id="Msg_3_33" name="Aceptación" sourceRef="c_aj" targetRef="s_doc"/>
    <bpmn:messageFlow id="Msg_3_34" name="Aviso de periodo pendiente" sourceRef="s_penE" targetRef="c_rev"/>
    <bpmn:messageFlow id="Msg_3_35" name="Reporte mensual" sourceRef="s_emi" targetRef="c_rev"/>
    <bpmn:messageFlow id="Msg_3_36" name="Factura electrónica" sourceRef="s_liq" targetRef="c_pay"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc3_Cliente" name="CLIENTE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P3_CLI">
      <bpmn:lane id="L3_cli" name="Cliente (gerencia de planta)">
        <bpmn:flowNodeRef>c_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_endP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_endN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_ajS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_aj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_ajE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c_s" name="Fin de mes">
      <bpmn:outgoing>Flow_c_s_c_rev</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_c_s"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="c_rev" name="Revisar el reporte o el aviso del mes">
      <bpmn:incoming>Flow_c_s_c_rev</bpmn:incoming>
      <bpmn:outgoing>Flow_c_rev_c_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="c_gw" name="¿Llegó factura?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_c_rev_c_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_c_gw_c_pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_c_gw_c_endN</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c_pay" name="Pagar la factura electrónica">
      <bpmn:incoming>Flow_c_gw_c_pay</bpmn:incoming>
      <bpmn:outgoing>Flow_c_pay_c_endP</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c_endP" name="Mes conciliado">
      <bpmn:incoming>Flow_c_pay_c_endP</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="c_endN" name="Sin pago este mes">
      <bpmn:incoming>Flow_c_gw_c_endN</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="c_ajS" name="Solicitud recibida">
      <bpmn:outgoing>Flow_c_ajS_c_aj</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c_ajS"/>
    </bpmn:startEvent>
    <bpmn:task id="c_aj" name="Aceptar el ajuste no rutinario">
      <bpmn:incoming>Flow_c_ajS_c_aj</bpmn:incoming>
      <bpmn:outgoing>Flow_c_aj_c_ajE</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c_ajE" name="Ajuste aceptado">
      <bpmn:incoming>Flow_c_aj_c_ajE</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c_s_c_rev" sourceRef="c_s" targetRef="c_rev"/>
    <bpmn:sequenceFlow id="Flow_c_rev_c_gw" sourceRef="c_rev" targetRef="c_gw"/>
    <bpmn:sequenceFlow id="Flow_c_pay_c_endP" sourceRef="c_pay" targetRef="c_endP"/>
    <bpmn:sequenceFlow id="Flow_c_ajS_c_aj" sourceRef="c_ajS" targetRef="c_aj"/>
    <bpmn:sequenceFlow id="Flow_c_aj_c_ajE" sourceRef="c_aj" targetRef="c_ajE"/>
    <bpmn:sequenceFlow id="Flow_c_gw_c_pay" name="Sí" sourceRef="c_gw" targetRef="c_pay"/>
    <bpmn:sequenceFlow id="Flow_c_gw_c_endN" name="No" sourceRef="c_gw" targetRef="c_endN"/>
  </bpmn:process>
  <bpmn:process id="Proc3_Cierre" name="VIRIDIA · Cierre mensual" isExecutable="true">
    <bpmn:laneSet id="LaneSet_P3_VIR">
      <bpmn:lane id="L3_ent" name="Entrega de Servicio">
        <bpmn:flowNodeRef>s_eva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gnr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_emi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gah</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rvm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_endS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3_tec" name="Tecnología y Gob. de Datos">
        <bpmn:flowNodeRef>s_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_g95</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gdc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_pen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_penE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3_fin" name="Finanzas e Inversión">
        <bpmn:flowNodeRef>s_liq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_endF</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_s" name="Inicio del cierre">
      <bpmn:outgoing>Flow_s_s_s_con</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="s_con" name="Consolidar lecturas y variables de operación del mes">
      <bpmn:incoming>Flow_s_s_s_con</bpmn:incoming>
      <bpmn:outgoing>Flow_s_con_s_m1</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DIA_do_lec_s_con"><bpmn:sourceRef>do_lec</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s_m1" name="Unión" gatewayDirection="Converging">
      <bpmn:incoming>Flow_s_con_s_m1</bpmn:incoming>
      <bpmn:incoming>Flow_s_gdc_s_m1</bpmn:incoming>
      <bpmn:outgoing>Flow_s_m1_s_val</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s_val" name="Validar completitud y calidad de los datos">
      <bpmn:incoming>Flow_s_m1_s_val</bpmn:incoming>
      <bpmn:outgoing>Flow_s_val_s_g95</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s_g95" name="¿Completitud ≥ 95 %?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_s_val_s_g95</bpmn:incoming>
      <bpmn:outgoing>Flow_s_g95_s_rec</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_g95_s_eva</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s_rec" name="Recuperar datos faltantes (respaldo de 72 h o lectura manual)">
      <bpmn:incoming>Flow_s_g95_s_rec</bpmn:incoming>
      <bpmn:outgoing>Flow_s_rec_s_gdc</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s_gdc" name="¿Datos completos?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_s_rec_s_gdc</bpmn:incoming>
      <bpmn:outgoing>Flow_s_gdc_s_pen</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_gdc_s_m1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s_pen" name="Marcar el periodo como pendiente">
      <bpmn:incoming>Flow_s_gdc_s_pen</bpmn:incoming>
      <bpmn:outgoing>Flow_s_pen_s_penE</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="s_penE" name="Periodo pendiente">
      <bpmn:incoming>Flow_s_pen_s_penE</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_s_penE"/>
    </bpmn:endEvent>
    <bpmn:dataObject id="DO_do_lec"/>
    <bpmn:dataObjectReference id="do_lec" name="LECTURA" dataObjectRef="DO_do_lec"/>
    <bpmn:task id="s_eva" name="Evaluar la línea base vigente con las condiciones del mes">
      <bpmn:incoming>Flow_s_g95_s_eva</bpmn:incoming>
      <bpmn:outgoing>Flow_s_eva_s_gnr</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DIA_do_lb_s_eva"><bpmn:sourceRef>do_lb</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:dataObject id="DO_do_lb"/>
    <bpmn:dataObjectReference id="do_lb" name="LINEA_BASE (versión vigente)" dataObjectRef="DO_do_lb"/>
    <bpmn:exclusiveGateway id="s_gnr" name="¿Hubo evento no rutinario?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_s_eva_s_gnr</bpmn:incoming>
      <bpmn:outgoing>Flow_s_gnr_s_doc</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_gnr_s_m2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s_doc" name="Documentar y acordar el ajuste no rutinario">
      <bpmn:incoming>Flow_s_gnr_s_doc</bpmn:incoming>
      <bpmn:outgoing>Flow_s_doc_s_m2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s_m2" name="Unión" gatewayDirection="Converging">
      <bpmn:incoming>Flow_s_doc_s_m2</bpmn:incoming>
      <bpmn:incoming>Flow_s_gnr_s_m2</bpmn:incoming>
      <bpmn:outgoing>Flow_s_m2_s_cal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s_cal" name="Calcular ahorro, % de reducción y tCO₂e">
      <bpmn:incoming>Flow_s_m2_s_cal</bpmn:incoming>
      <bpmn:outgoing>Flow_s_cal_s_emi</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_s_cal_do_ca"><bpmn:targetRef>do_ca</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObject id="DO_do_ca"/>
    <bpmn:dataObjectReference id="do_ca" name="CALCULO_AHORRO" dataObjectRef="DO_do_ca"/>
    <bpmn:task id="s_emi" name="Emitir reporte mensual de ahorro">
      <bpmn:incoming>Flow_s_cal_s_emi</bpmn:incoming>
      <bpmn:outgoing>Flow_s_emi_s_gah</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s_gah" name="¿Ahorro &gt; 0?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_s_emi_s_gah</bpmn:incoming>
      <bpmn:outgoing>Flow_s_gah_s_rvm</bpmn:outgoing>
      <bpmn:outgoing>Flow_s_gah_s_liq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="s_rvm" name="Revisar medidas de ahorro">
      <bpmn:incoming>Flow_s_gah_s_rvm</bpmn:incoming>
      <bpmn:outgoing>Flow_s_rvm_s_endS</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="s_endS" name="Periodo sin facturación">
      <bpmn:incoming>Flow_s_rvm_s_endS</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="s_liq" name="Liquidar participación (40 %) y emitir factura electrónica">
      <bpmn:incoming>Flow_s_gah_s_liq</bpmn:incoming>
      <bpmn:outgoing>Flow_s_liq_s_endF</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_s_liq_do_fac"><bpmn:targetRef>do_fac</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="s_endF" name="Factura emitida">
      <bpmn:incoming>Flow_s_liq_s_endF</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DO_do_fac"/>
    <bpmn:dataObjectReference id="do_fac" name="FACTURA" dataObjectRef="DO_do_fac"/>
    <bpmn:sequenceFlow id="Flow_s_s_s_con" sourceRef="s_s" targetRef="s_con"/>
    <bpmn:sequenceFlow id="Flow_s_con_s_m1" sourceRef="s_con" targetRef="s_m1"/>
    <bpmn:sequenceFlow id="Flow_s_m1_s_val" sourceRef="s_m1" targetRef="s_val"/>
    <bpmn:sequenceFlow id="Flow_s_val_s_g95" sourceRef="s_val" targetRef="s_g95"/>
    <bpmn:sequenceFlow id="Flow_s_pen_s_penE" sourceRef="s_pen" targetRef="s_penE"/>
    <bpmn:sequenceFlow id="Flow_s_g95_s_rec" name="No" sourceRef="s_g95" targetRef="s_rec"/>
    <bpmn:sequenceFlow id="Flow_s_rec_s_gdc" sourceRef="s_rec" targetRef="s_gdc"/>
    <bpmn:sequenceFlow id="Flow_s_gdc_s_pen" name="No" sourceRef="s_gdc" targetRef="s_pen"/>
    <bpmn:sequenceFlow id="Flow_s_gdc_s_m1" name="Sí: volver a validar" sourceRef="s_gdc" targetRef="s_m1"/>
    <bpmn:sequenceFlow id="Flow_s_g95_s_eva" name="Sí" sourceRef="s_g95" targetRef="s_eva"/>
    <bpmn:sequenceFlow id="Flow_s_eva_s_gnr" sourceRef="s_eva" targetRef="s_gnr"/>
    <bpmn:sequenceFlow id="Flow_s_doc_s_m2" sourceRef="s_doc" targetRef="s_m2"/>
    <bpmn:sequenceFlow id="Flow_s_m2_s_cal" sourceRef="s_m2" targetRef="s_cal"/>
    <bpmn:sequenceFlow id="Flow_s_cal_s_emi" sourceRef="s_cal" targetRef="s_emi"/>
    <bpmn:sequenceFlow id="Flow_s_emi_s_gah" sourceRef="s_emi" targetRef="s_gah"/>
    <bpmn:sequenceFlow id="Flow_s_rvm_s_endS" sourceRef="s_rvm" targetRef="s_endS"/>
    <bpmn:sequenceFlow id="Flow_s_gnr_s_doc" name="Sí" sourceRef="s_gnr" targetRef="s_doc"/>
    <bpmn:sequenceFlow id="Flow_s_gnr_s_m2" name="No" sourceRef="s_gnr" targetRef="s_m2"/>
    <bpmn:sequenceFlow id="Flow_s_gah_s_rvm" name="No" sourceRef="s_gah" targetRef="s_rvm"/>
    <bpmn:sequenceFlow id="Flow_s_gah_s_liq" name="Sí" sourceRef="s_gah" targetRef="s_liq"/>
    <bpmn:sequenceFlow id="Flow_s_liq_s_endF" sourceRef="s_liq" targetRef="s_endF"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_3" name="BPMN · Subproceso «Cierre mensual: cálculo y facturación del ahorro verificado»">
    <bpmndi:BPMNPlane id="Plane_3" bpmnElement="Collab_3">
      <bpmndi:BPMNShape id="P3_CLI_di" bpmnElement="P3_CLI" isHorizontal="true"><dc:Bounds x="0" y="0" width="1838" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_cli_di" bpmnElement="L3_cli" isHorizontal="true"><dc:Bounds x="26" y="0" width="1812" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_VIR_di" bpmnElement="P3_VIR" isHorizontal="true"><dc:Bounds x="0" y="168" width="1838" height="400"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_ent_di" bpmnElement="L3_ent" isHorizontal="true"><dc:Bounds x="26" y="168" width="1812" height="152"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_tec_di" bpmnElement="L3_tec" isHorizontal="true"><dc:Bounds x="26" y="320" width="1812" height="136"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_fin_di" bpmnElement="L3_fin" isHorizontal="true"><dc:Bounds x="26" y="456" width="1812" height="112"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_s_di" bpmnElement="c_s"><dc:Bounds x="149" y="36" width="34" height="34"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_rev_di" bpmnElement="c_rev"><dc:Bounds x="1243" y="21" width="146" height="64"/></bpmndi:BPMNShape>
