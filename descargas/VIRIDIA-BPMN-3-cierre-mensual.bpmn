      <bpmndi:BPMNShape id="c_pay_di" bpmnElement="c_pay"><dc:Bounds x="1493" y="21" width="146" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_endP_di" bpmnElement="c_endP"><dc:Bounds x="1669" y="36" width="34" height="34"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_endN_di" bpmnElement="c_endN"><dc:Bounds x="1419" y="98" width="34" height="34"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_ajS_di" bpmnElement="c_ajS"><dc:Bounds x="919" y="98" width="34" height="34"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_aj_di" bpmnElement="c_aj"><dc:Bounds x="968" y="83" width="146" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_ajE_di" bpmnElement="c_ajE"><dc:Bounds x="1129" y="98" width="34" height="34"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_s_di" bpmnElement="s_s"><dc:Bounds x="149" y="371" width="34" height="34"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_con_di" bpmnElement="s_con"><dc:Bounds x="201" y="356" width="146" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m1_di" bpmnElement="s_m1" isMarkerVisible="false"><dc:Bounds x="369" y="366" width="44" height="44"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_val_di" bpmnElement="s_val"><dc:Bounds x="433" y="356" width="146" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_g95_di" bpmnElement="s_g95" isMarkerVisible="true"><dc:Bounds x="599" y="366" width="44" height="44"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_rec_di" bpmnElement="s_rec"><dc:Bounds x="666" y="350" width="160" height="76"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gdc_di" bpmnElement="s_gdc" isMarkerVisible="true"><dc:Bounds x="849" y="366" width="44" height="44"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_pen_di" bpmnElement="s_pen"><dc:Bounds x="913" y="356" width="146" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_penE_di" bpmnElement="s_penE"><dc:Bounds x="1074" y="371" width="34" height="34"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_lec_di" bpmnElement="do_lec"><dc:Bounds x="259" y="225" width="30" height="38"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_eva_di" bpmnElement="s_eva"><dc:Bounds x="666" y="230" width="160" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="do_lb_di" bpmnElement="do_lb"><dc:Bounds x="731" y="179" width="30" height="38"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_gnr_di" bpmnElement="s_gnr" isMarkerVisible="true"><dc:Bounds x="849" y="240" width="44" height="44"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_doc_di" bpmnElement="s_doc"><dc:Bounds x="913" y="230" width="146" height="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_m2_di" bpmnElement="s_m2" isMarkerVisible="false"><dc:Bounds x="1124" y="240" width="44" height="44"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_cal_di" bpmnElement="s_cal"><dc:Bounds x="1178" y="230" width="146" height="64"/></bpmndi:BPMNShape>
