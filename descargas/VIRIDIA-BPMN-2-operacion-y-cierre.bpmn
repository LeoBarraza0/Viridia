<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Def_2" targetNamespace="http://viridia.example/bpmn" exporter="generar_bpmn.py (VIRIDIA, Corte III)" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_2">
    <bpmn:documentation>VIRIDIA S.A.S. BIC (empresa ficticia, uso académico). BPMN · Ciclo de servicio, parte 2: operación y cierre del contrato (fases 8 a 12).</bpmn:documentation>
    <bpmn:participant id="P2_CLI" name="CLIENTE" processRef="Proc2_Cliente"/>
    <bpmn:participant id="P2_VIR" name="VIRIDIA S.A.S. BIC" processRef="Proc2_Viridia"/>
    <bpmn:participant id="P2_VER" name="VERIFICADOR" processRef="Proc2_Verificador"/>
    <bpmn:messageFlow id="Msg_2_36" name="Alerta de desviación" sourceRef="v_alE" targetRef="c_alS"/>
    <bpmn:messageFlow id="Msg_2_37" name="Oferta de renovación" sourceRef="v_of" targetRef="c_eval"/>
    <bpmn:messageFlow id="Msg_2_38" name="Respuesta" sourceRef="c_eval" targetRef="v_of"/>
    <bpmn:messageFlow id="Msg_2_39" name="Equipos devueltos" sourceRef="c_dev" targetRef="v_ret"/>
    <bpmn:messageFlow id="Msg_2_40" name="Expediente MRV" sourceRef="v_mrv" targetRef="x_s"/>
    <bpmn:messageFlow id="Msg_2_41" name="Reporte de verificación" sourceRef="x_rev" targetRef="v_rcv"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc2_Cliente" name="CLIENTE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2_CLI">
      <bpmn:lane id="L2_cli" name="Cliente (gerencia de planta)">
        <bpmn:flowNodeRef>c_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_dev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_alS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_aj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_alE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="c_A" name="A">
      <bpmn:outgoing>Flow_c_A_c_eval</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LED_c_A" name="A"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c_eval" name="Decidir sobre la renovación">
      <bpmn:incoming>Flow_c_A_c_eval</bpmn:incoming>
      <bpmn:outgoing>Flow_c_eval_c_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="c_gw" name="¿Renueva?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_c_eval_c_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_c_gw_c_B</bpmn:outgoing>
      <bpmn:outgoing>Flow_c_gw_c_dev</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="c_B" name="B">
      <bpmn:incoming>Flow_c_gw_c_B</bpmn:incoming>
      <bpmn:linkEventDefinition id="LED_c_B" name="B"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="c_dev" name="Devolver los equipos en comodato">
      <bpmn:incoming>Flow_c_gw_c_dev</bpmn:incoming>
      <bpmn:outgoing>Flow_c_dev_c_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c_end" name="Servicio terminado">
      <bpmn:incoming>Flow_c_dev_c_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="c_alS" name="Alerta recibida">
      <bpmn:outgoing>Flow_c_alS_c_aj</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_c_alS"/>
    </bpmn:startEvent>
    <bpmn:task id="c_aj" name="Ajustar la operación según la alerta">
      <bpmn:incoming>Flow_c_alS_c_aj</bpmn:incoming>
      <bpmn:outgoing>Flow_c_aj_c_alE</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="c_alE" name="Operación ajustada">
      <bpmn:incoming>Flow_c_aj_c_alE</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c_A_c_eval" sourceRef="c_A" targetRef="c_eval"/>
    <bpmn:sequenceFlow id="Flow_c_eval_c_gw" sourceRef="c_eval" targetRef="c_gw"/>
    <bpmn:sequenceFlow id="Flow_c_dev_c_end" sourceRef="c_dev" targetRef="c_end"/>
    <bpmn:sequenceFlow id="Flow_c_alS_c_aj" sourceRef="c_alS" targetRef="c_aj"/>
    <bpmn:sequenceFlow id="Flow_c_aj_c_alE" sourceRef="c_aj" targetRef="c_alE"/>
    <bpmn:sequenceFlow id="Flow_c_gw_c_B" name="Sí" sourceRef="c_gw" targetRef="c_B"/>
    <bpmn:sequenceFlow id="Flow_c_gw_c_dev" name="No" sourceRef="c_gw" targetRef="c_dev"/>
  </bpmn:process>
  <bpmn:process id="Proc2_Viridia" name="VIRIDIA S.A.S. BIC" isExecutable="true">
    <bpmn:laneSet id="LaneSet_P2_VIR">
      <bpmn:lane id="L2_com" name="Comercial y Mercadeo">
        <bpmn:flowNodeRef>v_of</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_gr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_B</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_ent" name="Entrega de Servicio">
        <bpmn:flowNodeRef>v_rep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_repE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_al</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_alE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_mrv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_rcv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_tec" name="Tecnología y Gob. de Datos">
        <bpmn:flowNodeRef>v_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_mon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bband</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_monE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_id" name="I+D en IA">
        <bpmn:flowNodeRef>v_rec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_sos" name="Sostenibilidad y Op. Verdes">
        <bpmn:flowNodeRef>v_cons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_fin" name="Finanzas e Inversión">
        <bpmn:flowNodeRef>v_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_t</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_gq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_ga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_m3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v_gt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:intermediateCatchEvent id="v_A" name="A">
      <bpmn:outgoing>Flow_v_A_v_par</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LED_v_A" name="A"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="v_par" name="" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_v_A_v_par</bpmn:incoming>
      <bpmn:outgoing>Flow_v_par_v_mon</bpmn:outgoing>
      <bpmn:outgoing>Flow_v_par_v_m1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="v_mon" name="Monitorear consumo y estado de medidores">
      <bpmn:incoming>Flow_v_par_v_mon</bpmn:incoming>
      <bpmn:outgoing>Flow_v_mon_v_monE</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics/>
    </bpmn:task>
    <bpmn:boundaryEvent id="b24" name="Medidor sin datos &gt; 24 h" attachedToRef="v_mon" cancelActivity="false">
      <bpmn:outgoing>Flow_b24_v_rep</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_b24"><bpmn:condition xsi:type="bpmn:tFormalExpression">horas sin lecturas &gt; 24</bpmn:condition></bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="bband" name="Consumo fuera de banda ±10 %" attachedToRef="v_mon" cancelActivity="false">
      <bpmn:outgoing>Flow_bband_v_al</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_bband"><bpmn:condition xsi:type="bpmn:tFormalExpression">|real - esperado| / esperado &gt; 0,10</bpmn:condition></bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="v_monE" name="Monitoreo cerrado">
      <bpmn:incoming>Flow_v_mon_v_monE</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="v_rep" name="Reparar o reemplazar el medidor">
      <bpmn:incoming>Flow_b24_v_rep</bpmn:incoming>
      <bpmn:outgoing>Flow_v_rep_v_repE</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="v_repE" name="Medidor restablecido">
      <bpmn:incoming>Flow_v_rep_v_repE</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="v_al" name="Emitir alerta de desviación al cliente">
      <bpmn:incoming>Flow_bband_v_al</bpmn:incoming>
      <bpmn:outgoing>Flow_v_al_v_alE</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="v_alE" name="Alerta enviada">
      <bpmn:incoming>Flow_v_al_v_alE</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_v_alE"/>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="v_m1" name="Unión" gatewayDirection="Converging">
      <bpmn:incoming>Flow_v_par_v_m1</bpmn:incoming>
      <bpmn:incoming>Flow_v_gt_v_m1</bpmn:incoming>
      <bpmn:outgoing>Flow_v_m1_v_t</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="v_t" name="Primer día de cada mes">
      <bpmn:incoming>Flow_v_m1_v_t</bpmn:incoming>
      <bpmn:outgoing>Flow_v_t_v_call</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_v_t"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="v_call" name="Cierre mensual: cálculo y facturación del ahorro verificado" calledElement="Proc3_Cierre">
      <bpmn:incoming>Flow_v_t_v_call</bpmn:incoming>
      <bpmn:outgoing>Flow_v_call_v_gq</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="v_gq" name="¿Fin de trimestre?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_v_call_v_gq</bpmn:incoming>
      <bpmn:outgoing>Flow_v_gq_v_rec</bpmn:outgoing>
      <bpmn:outgoing>Flow_v_gq_v_m2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="v_rec" name="Recalcular línea base (nueva versión)">
      <bpmn:incoming>Flow_v_gq_v_rec</bpmn:incoming>
      <bpmn:outgoing>Flow_v_rec_v_m2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="v_m2" name="Unión" gatewayDirection="Converging">
      <bpmn:incoming>Flow_v_gq_v_m2</bpmn:incoming>
      <bpmn:incoming>Flow_v_rec_v_m2</bpmn:incoming>
      <bpmn:outgoing>Flow_v_m2_v_ga</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="v_ga" name="¿Fin de año contractual?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_v_m2_v_ga</bpmn:incoming>
      <bpmn:outgoing>Flow_v_ga_v_mrv</bpmn:outgoing>
      <bpmn:outgoing>Flow_v_ga_v_m3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="v_mrv" name="Preparar expediente MRV anual">
      <bpmn:incoming>Flow_v_ga_v_mrv</bpmn:incoming>
      <bpmn:outgoing>Flow_v_mrv_v_rcv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="v_rcv" name="Reporte recibido">
      <bpmn:incoming>Flow_v_mrv_v_rcv</bpmn:incoming>
      <bpmn:outgoing>Flow_v_rcv_v_cons</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_v_rcv"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="v_cons" name="Consolidar informe BIC y reporte ESG">
      <bpmn:incoming>Flow_v_rcv_v_cons</bpmn:incoming>
      <bpmn:outgoing>Flow_v_cons_v_m3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="v_m3" name="Unión" gatewayDirection="Converging">
      <bpmn:incoming>Flow_v_ga_v_m3</bpmn:incoming>
      <bpmn:incoming>Flow_v_cons_v_m3</bpmn:incoming>
      <bpmn:outgoing>Flow_v_m3_v_gt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="v_gt" name="¿Termina el contrato?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_v_m3_v_gt</bpmn:incoming>
      <bpmn:outgoing>Flow_v_gt_v_m1</bpmn:outgoing>
      <bpmn:outgoing>Flow_v_gt_v_of</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="v_of" name="Ofrecer la renovación al cliente">
      <bpmn:incoming>Flow_v_gt_v_of</bpmn:incoming>
      <bpmn:outgoing>Flow_v_of_v_gr</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="v_gr" name="¿Se renueva el contrato?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_v_of_v_gr</bpmn:incoming>
      <bpmn:outgoing>Flow_v_gr_v_B</bpmn:outgoing>
      <bpmn:outgoing>Flow_v_gr_v_ret</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="v_B" name="B">
      <bpmn:incoming>Flow_v_gr_v_B</bpmn:incoming>
      <bpmn:linkEventDefinition id="LED_v_B" name="B"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="v_ret" name="Retirar y reacondicionar equipos">
      <bpmn:incoming>Flow_v_gr_v_ret</bpmn:incoming>
      <bpmn:outgoing>Flow_v_ret_v_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="v_end" name="Contrato cerrado">
      <bpmn:incoming>Flow_v_ret_v_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_v_A_v_par" sourceRef="v_A" targetRef="v_par"/>
    <bpmn:sequenceFlow id="Flow_v_par_v_mon" sourceRef="v_par" targetRef="v_mon"/>
    <bpmn:sequenceFlow id="Flow_v_mon_v_monE" sourceRef="v_mon" targetRef="v_monE"/>
    <bpmn:sequenceFlow id="Flow_b24_v_rep" sourceRef="b24" targetRef="v_rep"/>
    <bpmn:sequenceFlow id="Flow_v_rep_v_repE" sourceRef="v_rep" targetRef="v_repE"/>
    <bpmn:sequenceFlow id="Flow_bband_v_al" sourceRef="bband" targetRef="v_al"/>
    <bpmn:sequenceFlow id="Flow_v_al_v_alE" sourceRef="v_al" targetRef="v_alE"/>
    <bpmn:sequenceFlow id="Flow_v_par_v_m1" sourceRef="v_par" targetRef="v_m1"/>
    <bpmn:sequenceFlow id="Flow_v_m1_v_t" sourceRef="v_m1" targetRef="v_t"/>
    <bpmn:sequenceFlow id="Flow_v_t_v_call" sourceRef="v_t" targetRef="v_call"/>
    <bpmn:sequenceFlow id="Flow_v_call_v_gq" sourceRef="v_call" targetRef="v_gq"/>
    <bpmn:sequenceFlow id="Flow_v_m2_v_ga" sourceRef="v_m2" targetRef="v_ga"/>
    <bpmn:sequenceFlow id="Flow_v_mrv_v_rcv" sourceRef="v_mrv" targetRef="v_rcv"/>
    <bpmn:sequenceFlow id="Flow_v_m3_v_gt" sourceRef="v_m3" targetRef="v_gt"/>
    <bpmn:sequenceFlow id="Flow_v_of_v_gr" sourceRef="v_of" targetRef="v_gr"/>
    <bpmn:sequenceFlow id="Flow_v_ret_v_end" sourceRef="v_ret" targetRef="v_end"/>
    <bpmn:sequenceFlow id="Flow_v_gq_v_rec" name="Sí" sourceRef="v_gq" targetRef="v_rec"/>
    <bpmn:sequenceFlow id="Flow_v_gq_v_m2" name="No" sourceRef="v_gq" targetRef="v_m2"/>
    <bpmn:sequenceFlow id="Flow_v_rec_v_m2" sourceRef="v_rec" targetRef="v_m2"/>
    <bpmn:sequenceFlow id="Flow_v_ga_v_mrv" name="Sí" sourceRef="v_ga" targetRef="v_mrv"/>
    <bpmn:sequenceFlow id="Flow_v_ga_v_m3" name="No" sourceRef="v_ga" targetRef="v_m3"/>
    <bpmn:sequenceFlow id="Flow_v_rcv_v_cons" sourceRef="v_rcv" targetRef="v_cons"/>
    <bpmn:sequenceFlow id="Flow_v_cons_v_m3" sourceRef="v_cons" targetRef="v_m3"/>
    <bpmn:sequenceFlow id="Flow_v_gt_v_m1" name="No" sourceRef="v_gt" targetRef="v_m1"/>
    <bpmn:sequenceFlow id="Flow_v_gt_v_of" name="Sí" sourceRef="v_gt" targetRef="v_of"/>
    <bpmn:sequenceFlow id="Flow_v_gr_v_B" name="Sí" sourceRef="v_gr" targetRef="v_B"/>
    <bpmn:sequenceFlow id="Flow_v_gr_v_ret" name="No" sourceRef="v_gr" targetRef="v_ret"/>
  </bpmn:process>
  <bpmn:process id="Proc2_Verificador" name="VERIFICADOR" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P2_VER">
      <bpmn:lane id="L2_ver" name="Verificador independiente">
        <bpmn:flowNodeRef>x_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="x_s" name="Expediente recibido">
      <bpmn:outgoing>Flow_x_s_x_rev</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_x_s"/>
    </bpmn:startEvent>
    <bpmn:task id="x_rev" name="Revisar metodología y ahorro del año; emitir el reporte">
      <bpmn:incoming>Flow_x_s_x_rev</bpmn:incoming>
      <bpmn:outgoing>Flow_x_rev_x_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="x_end" name="Verificación emitida">
      <bpmn:incoming>Flow_x_rev_x_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_x_s_x_rev" sourceRef="x_s" targetRef="x_rev"/>
    <bpmn:sequenceFlow id="Flow_x_rev_x_end" sourceRef="x_rev" targetRef="x_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_2" name="BPMN · Ciclo de servicio, parte 2: operación y cierre del contrato (fases 8 a 12)">
    <bpmndi:BPMNPlane id="Plane_2" bpmnElement="Collab_2">
      <bpmndi:BPMNShape id="P2_CLI_di" bpmnElement="P2_CLI" isHorizontal="true"><dc:Bounds x="0" y="0" width="1838" height="152"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_cli_di" bpmnElement="L2_cli" isHorizontal="true"><dc:Bounds x="26" y="0" width="1812" height="152"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_VIR_di" bpmnElement="P2_VIR" isHorizontal="true"><dc:Bounds x="0" y="170" width="1838" height="676"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_com_di" bpmnElement="L2_com" isHorizontal="true"><dc:Bounds x="26" y="170" width="1812" height="104"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_ent_di" bpmnElement="L2_ent" isHorizontal="true"><dc:Bounds x="26" y="274" width="1812" height="116"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_tec_di" bpmnElement="L2_tec" isHorizontal="true"><dc:Bounds x="26" y="390" width="1812" height="124"/></bpmndi:BPMNShape>
